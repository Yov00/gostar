package docs

import "templ_workout/views/layouts"

templ Docs() {
@layouts.App() {
<div class="container mx-auto px-4 py-12 max-w-4xl space-y-12">
	<h1 class="text-5xl font-bold text-primary mb-20">🚀 Welcome to the Documentation</h1>

	<div class="prose max-w-none">
		<section class="mb-6">
			<h2 class="text-3xl font-semibold">📦 Getting Started</h2>
			<p>This application is built using Go, Templ, and Air for a modern, efficient development experience.</p>
		</section>

		<section class="mb-6">
			<h2 class="text-3xl font-semibold">⚙️ Prerequisites</h2>
			<ul class="list-disc list-inside bg-base-100 p-4 rounded-lg shadow">
				<li>Install Go (version 1.21 or later)</li>
				<li>Install Templ CLI</li>
				<li>Install Air for hot reloading</li>
			</ul>
		</section>

		<section class="mb-6">
			<h2 class="text-3xl font-semibold">📥 Installation Steps</h2>
			<div class="grid gap-6">
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title">1. Install Go Modules</h3>
						<pre class="bg-base-200 p-3 rounded"><code>go mod init your-project-name
go get github.com/a-h/templ
go get github.com/cosmtrek/air</code></pre>
					</div>
				</div>
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title">2. Install Templ CLI</h3>
						<pre
							class="bg-base-200 p-3 rounded"><code>go install github.com/a-h/templ/cmd/templ@latest</code></pre>
					</div>
				</div>
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title">3. Install Air</h3>
						<pre
							class="bg-base-200 p-3 rounded"><code>go install github.com/cosmtrek/air@latest</code></pre>
					</div>
				</div>
			</div>
		</section>

		<section class="mb-6">
			<h2 class="text-3xl font-semibold">⚡ Development Workflow</h2>
			<div class="grid gap-6">
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title">Templ Watch Mode</h3>
						<p>Auto-compile your `.templ` files when changed:</p>
						<pre class="bg-base-200 p-3 rounded"><code>templ generate --watch</code></pre>
						<p>This will regenerate Go code on changes.</p>
					</div>
				</div>
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title">Air for Hot Reloading</h3>
						<p>Run your app with hot reloading:</p>
						<pre class="bg-base-200 p-3 rounded"><code>air</code></pre>
						<p>Air watches for file changes and restarts automatically.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="mb-6">
			<h2 class="text-3xl font-semibold">🎯 Benefits of This Stack</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title text-primary">Go</h3>
						<ul class="list-disc list-inside">
							<li>High performance</li>
							<li>Strong typing</li>
							<li>Great concurrency</li>
							<li>Built-in testing</li>
						</ul>
					</div>
				</div>
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title text-secondary">Templ</h3>
						<ul class="list-disc list-inside">
							<li>Type-safe templates</li>
							<li>Compile-time checks</li>
							<li>Fast rendering</li>
							<li>Great IDE support</li>
						</ul>
					</div>
				</div>
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title text-accent">Air</h3>
						<ul class="list-disc list-inside">
							<li>Fast hot reload</li>
							<li>Configurable</li>
							<li>Lightweight</li>
							<li>Cross-platform</li>
						</ul>
					</div>
				</div>
				<div class="card bg-base-100 shadow-md">
					<div class="card-body">
						<h3 class="card-title">Dev Experience</h3>
						<ul class="list-disc list-inside">
							<li>Rapid iteration</li>
							<li>Type safety across stack</li>
							<li>Production ready</li>
							<li>Minimal boilerplate</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
	</div>
</div>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.querySelectorAll("pre code").forEach((block) => {
			block.style.cursor = "pointer";

			block.addEventListener("click", () => {
				const text = block.innerText;
				navigator.clipboard.writeText(text).then(() => {
					block.classList.add("bg-green-100");
					block.setAttribute("data-tooltip", "Copied!");



					setTimeout(() => {
						block.classList.remove("bg-green-100");
						block.removeAttribute("data-tooltip");
					}, 1000);
				});
			});
		});
	});
</script>
}
}